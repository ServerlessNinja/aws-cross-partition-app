{
  "name": "global-invoicing",
  "version": "0.1.0",
  "bin": {
    "global-invoicing": "bin/global-invoicing.js"
  },
  "config": {
    "profile": {
      "aws": "standard",
      "eusc": "european"
    }
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "synth:all": "npx cdk synth --all --validation --quiet --output cdk.out",
    "deploy:european": "npx cdk deploy 'European/**' --profile ${npm_package_config_profile_eusc}",
    "deploy:standard": "npx cdk deploy 'Standard/**' --profile ${npm_package_config_profile_aws}",
    "certs:generate": "npx ts-node src/scripts/generate-certs.ts",
    "certs:upload": "npx ts-node src/scripts/upload-certs.ts",
    "params:get": "npx ts-node src/scripts/get-ssm-params.ts",
    "seed:invoices": "npx ts-node src/scripts/seed-invoices.ts",
    "seed:customers": "npx ts-node src/scripts/seed-customers.ts",
    "destroy:european": "npx cdk destroy 'European/**' --profile ${npm_package_config_profile_eusc}",
    "destroy:standard": "npx cdk destroy 'Standard/**' --profile ${npm_package_config_profile_aws}",
    "cache:clear": "rm -rf cdk.out/cache"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.2",
    "@types/node-forge": "^1.3.14",
    "aws-cdk": "^2.1122.0",
    "dotenv-cli": "^11.0.0",
    "jest": "^30",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1032.0",
    "@aws-sdk/client-eventbridge": "^3.1032.0",
    "@aws-sdk/client-secrets-manager": "^3.1030.0",
    "@aws-sdk/client-ssm": "^3.1031.0",
    "@aws-sdk/lib-dynamodb": "^3.1032.0",
    "aws-cdk-lib": "^2.254.0",
    "constructs": "^10.5.0",
    "node-forge": "^1.4.0"
  }
}
